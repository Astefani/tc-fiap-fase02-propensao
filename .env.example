# Exemplo de variáveis de ambiente. Copie para .env e ajuste.
#   cp .env.example .env
#
# Este arquivo guarda apenas configuração de AMBIENTE (onde as coisas acontecem).
# Decisões de modelagem (seed, hiperparâmetros, split) ficam em params.yaml,
# porque mudá-las invalida o modelo e o DVC precisa detectar isso.

# URI de tracking do MLflow.
#
#   Default do código ...... sqlite:///mlflow-store/mlflow.db
#     Roda sem credencial nenhuma. É o que um clone limpo usa se não houver .env,
#     e é o que garante que `dvc repro` funcione para quem só quer reproduzir.
#
#   Servidor hospedado ..... https://dagshub.com/<usuario>/<repo>.mlflow
#     Usado nesta entrega para os runs oficiais. Exige as duas credenciais abaixo.
#     Vantagem: Registry e aliases visíveis na web, sem precisar subir UI local.
#
# ATENÇÃO: o Model Registry NÃO funciona com backend de arquivo (mlruns/) sem
# MLFLOW_ALLOW_FILE_STORE=true — o file store entrou em modo de manutenção e o
# MLflow o recusa por padrão. Por isso sqlite, e não file store.
MLFLOW_TRACKING_URI=sqlite:///mlflow-store/mlflow.db

# Credenciais — SÓ para servidor remoto. Deixe vazias com o default sqlite.
# No DagsHub: usuário da conta + access token (Settings -> Tokens).
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Nome do experimento e do modelo registrado
MLFLOW_EXPERIMENT_NAME=propensao-compra
MLFLOW_REGISTERED_MODEL=propensao-compra

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
